*.mp4

# Personal exported photos/clips - large binaries, not meant for version
# control. Applies to any trip folder (e.g. southofbergenislands/media,
# bergenandflam/maps), not just one.
*/media
*/maps

# Synthetic test fixtures - regenerated by tests/generate_test_assets.py
tests/fixtures/

# Cached audio downloaded by make_video.py when `music:` is a URL
.music_cache/

# Python
__pycache__/
*.pyc

# macOS
.DS_Store
